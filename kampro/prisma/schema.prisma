generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Catálogo (cada variante es un SKU independiente) ───────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id           String        @id @default(cuid())
  sku          String        @unique
  name         String
  capacityMl   Int
  /// Precio de venta en PYG. Null hasta que el módulo comercial lo defina — no inventar.
  unitPricePyg Int?
  /// Último costo unitario en PYG cuando hay equivalencia (compra+importación con FX o moneda PYG).
  unitCostPyg  Int?
  /// Unidades físicas en depósito (salen al cerrar la venta, no al crear el pedido).
  stockQty     Int           @default(0)
  /// Pedidos abiertos que todavía no cerraron: no se pueden volver a vender.
  reservedQty  Int           @default(0)
  status       ProductStatus @default(ACTIVE)
  /// TODO negocio: criterio de reposición. No usar todavía.
  reorderPoint Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  suppliers           SupplierProduct[]
  purchases           Purchase[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderLines  PurchaseOrderLine[]
  stockMovements      StockMovement[]
  inventoryLots       InventoryLot[]
}

// ─── Importación y abastecimiento ───────────────────────────────────────────

enum PurchaseOrderStatus {
  BORRADOR
  CONFIRMADA
  CERRADA
  CANCELADA
}

enum ShipmentStatus {
  COORDINADO
  EN_TRANSITO
  LLEGADO
  RECEPCIONADO
}

enum ImportCostType {
  LOGISTICA
  ADUANA
  IMPUESTO
  OTRO
}

enum ReceptionIncidentType {
  FALTANTE
  SOBRANTE
  DANADO
  OTRO
}

enum StockMovementReason {
  RECEPCION
  AJUSTE
  RESERVA
  VENTA
  CANCELACION_PEDIDO
  CANCELACION_COMPRA
  DEVOLUCION
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  contact    String?
  country    String   @default("CN")
  alibabaUrl String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products       SupplierProduct[]
  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
}

model SupplierProduct {
  supplierId String
  productId  String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([supplierId, productId])
}

model Forwarder {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments      Shipment[]
  purchaseOrders PurchaseOrder[]
}

model Purchase {
  id          String   @id @default(cuid())
  purchasedAt DateTime
  productId   String
  supplierId  String
  shipmentId  String?
  quantity    Int
  unitPrice   Decimal
  total       Decimal
  currency    String   @default("USD")
  /// Tipo de cambio a PYG al momento de registrar (opcional). No se inventa.
  fxRateToPyg Decimal?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product    Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  shipment   Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  costs      ImportCost[]
  receptions Reception[]

  @@index([productId])
  @@index([supplierId])
  @@index([shipmentId])
  @@index([purchasedAt])
}

/// Orden de compra a proveedor (flujo operativo de importación).
model PurchaseOrder {
  id             String              @id @default(cuid())
  number         Int?                @unique
  numberLabel    String?             @unique
  status         PurchaseOrderStatus @default(BORRADOR)
  orderedAt      DateTime
  forwarderId    String
  supplierId     String
  origin         String
  destination    String
  productId      String
  quantity       Int
  unitPrice      Decimal
  freight        Decimal             @default(0)
  otherCharges   Decimal             @default(0)
  /// Tipo de cambio de la compra en China a PYG. Al confirmar el pago queda como tipo contable.
  fxRateToPyg    Decimal?
  comments       String?
  currency       String              @default("USD")
  paymentReceipt String?
  /// Caja o banco desde donde salió el pago al proveedor.
  treasury       TreasuryAccount     @default(BANCO)
  /// Caja o banco del pago local (aduana/despacho) al cerrar.
  localTreasury  TreasuryAccount     @default(BANCO)
  confirmedAt    DateTime?
  receivedAt     DateTime?
  customsCost    Decimal?
  dispatchCost   Decimal?
  closedAt       DateTime?
  cancelledAt    DateTime?
  refundAmountPyg Int?
  refundTreasury  TreasuryAccount?
  refundAt        DateTime?
  refundReference String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  forwarder      Forwarder               @relation(fields: [forwarderId], references: [id], onDelete: Restrict)
  supplier       Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines          PurchaseOrderLine[]
  invoices       PurchaseOrderInvoice[]
  stockMovements StockMovement[]
  inventoryLots  InventoryLot[]

  @@index([status])
  @@index([orderedAt])
  @@index([supplierId])
  @@index([productId])
  @@index([forwarderId])
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseOrderInvoice {
  id              String   @id @default(cuid())
  purchaseOrderId String
  invoiceNumber   String
  ruc             String
  legalName       String
  issuedAt        DateTime
  amount          Decimal
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([issuedAt])
}

/// Metas de ingresos en Gs. Null = no cargada (no se inventa).
model SalesTarget {
  id        String   @id @default("default")
  dayPyg    Int?
  weekPyg   Int?
  monthPyg  Int?
  yearPyg   Int?
  updatedAt DateTime @updatedAt
}

model Shipment {
  id          String         @id @default(cuid())
  forwarderId String
  reference   String
  departedAt  DateTime?
  etaAt       DateTime?
  arrivedAt   DateTime?
  status      ShipmentStatus @default(COORDINADO)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  forwarder  Forwarder    @relation(fields: [forwarderId], references: [id], onDelete: Restrict)
  purchases  Purchase[]
  costs      ImportCost[]
  receptions Reception[]

  @@unique([reference])
  @@index([forwarderId])
  @@index([status])
}

model ImportCost {
  id          String         @id @default(cuid())
  shipmentId  String
  /// Si está set, el costo es de esa compra; si no, se prorratea entre las compras del envío (por cantidad).
  purchaseId  String?
  type        ImportCostType
  description String?
  amount      Decimal
  currency    String         @default("USD")
  fxRateToPyg Decimal?
  incurredAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shipment Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([purchaseId])
}

model Reception {
  id          String   @id @default(cuid())
  shipmentId  String
  purchaseId  String
  receivedQty Int
  receivedAt  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  shipment  Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  purchase  Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  incidents ReceptionIncident[]
  movements StockMovement[]

  @@index([shipmentId])
  @@index([purchaseId])
  @@index([receivedAt])
}

model ReceptionIncident {
  id           String                 @id @default(cuid())
  receptionId  String
  type         ReceptionIncidentType
  quantity     Int
  notes        String?

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id          String               @id @default(cuid())
  productId   String
  quantity    Int
  reason      StockMovementReason
  receptionId     String?
  orderId         String?
  purchaseOrderId String?
  notes           String?
  createdAt       DateTime             @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  reception     Reception?     @relation(fields: [receptionId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([purchaseOrderId])
}

// ─── Pedidos y pagos (venta) ────────────────────────────────────────────────

enum OrderZone {
  ASUNCION
  INTERIOR
}

enum OrderStatus {
  CONFIRMADO
  PENDIENTE_DE_PAGO
  PAGO_CONFIRMADO
  LISTO_PARA_DESPACHO
  ENVIADO
  ENTREGADO
  CERRADO
  CANCELADO
  DEVUELTO
}

enum InvoiceSettlement {
  CONTADO
  CREDITO
}

enum TreasuryAccount {
  CAJA
  BANCO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

enum PaymentStatus {
  PENDIENTE
  CONFIRMADO
  REEMBOLSADO
}

model Order {
  id               String      @id @default(cuid())
  number           Int?        @unique
  numberLabel      String?     @unique
  /// Resumen denormalizado de las líneas (varios SKU unidos).
  sku              String
  productName      String
  quantity         Int
  /// Porcentaje. 15 automático solo si quantity === 2 en esa línea; el resto queda 0/manual.
  discountApplied  Int         @default(0)
  totalAmount      Int
  zone             OrderZone
  customerPhone    String
  contactName      String?
  recipientName    String
  invoiceName      String
  ruc              String
  /// Contado o crédito al emitir la factura. Define CxC vs tesorería/anticipo al cerrar.
  invoiceSettlement InvoiceSettlement @default(CONTADO)
  status           OrderStatus
  sessionId        String?
  chatId           String?
  /// Asunción (delivery)
  locationLat      Float?
  locationLng      Float?
  locationText     String?
  preferredTime    String?
  paymentMethodPreferred PaymentMethod?
  /// Interior (encomienda)
  city             String?
  carrier          String?
  /// Costo de envío (encomienda / delivery / combustible), en PYG. Se carga en Pedidos cuando está ENVIADO.
  shippingCostPyg  Int?
  invoiceNumber    String?
  invoiceIssuer    String?
  invoiceIssuedAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items          OrderLine[]
  payments       Payment[]
  stockMovements StockMovement[]
  lotConsumptions LotConsumption[]

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([zone])
  @@index([invoiceNumber])
}

model InvoiceSequence {
  id         String @id @default("default")
  nextNumber Int    @default(14)
  issuer     String @default("Pablo Canale")
}

/// Chats de WhatsApp marcados para seguimiento (capa Kampro, por sessionId + chatId).
model ChatFollowUp {
  id        String   @id @default(cuid())
  sessionId String
  chatId    String
  createdAt DateTime @default(now())

  @@unique([sessionId, chatId])
  @@index([sessionId])
}

model OrderLine {
  id               String   @id @default(cuid())
  orderId          String
  sku              String
  productName      String
  quantity         Int
  unitPricePyg     Int
  discountApplied  Int      @default(0)
  lineTotal        Int
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  amount    Int
  method    PaymentMethod
  paidAt    DateTime
  status    PaymentStatus @default(CONFIRMADO)
  reference String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Contabilidad ───────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST
  EXPENSE
}

enum AccountRole {
  CAJA
  BANCO
  CXC
  ANTICIPO_CLIENTES
  ANTICIPO_PROVEEDORES
  IVA_CREDITO
  IVA_DEBITO
  INVENTARIO
  TRANSITO
  CXP
  VENTAS
  DESCUENTOS
  CMV
  FLETE_VENTAS
  PUBLICIDAD
  SUELDOS
  CARGAS_SOCIALES
  GASTOS_BANCARIOS
  GASTOS_GENERALES
  AJUSTE_INVENTARIO
  CAPITAL
  RESULTADOS_ACUMULADOS
  RESULTADO_EJERCICIO
  BIENES_USO
  REMUNERACIONES_PAGAR
}

enum JournalSource {
  ORDER
  PAYMENT
  PURCHASE_ORDER
  EXPENSE
  MANUAL
  STOCK
  OPENING
}

enum ExpenseKind {
  GENERAL
  SALARIO
  PUBLICIDAD
  OTRO
}

enum CashFlowClass {
  OPERATING
  INVESTING
  FINANCING
}

model Account {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  type      AccountType
  role      AccountRole? @unique
  parentId  String?
  postable  Boolean      @default(true)
  system    Boolean      @default(false)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]
  expenses Expense[]

  @@index([parentId])
  @@index([type])
}

model OperationSequence {
  id         String @id
  nextNumber Int    @default(1)
}

model JournalSequence {
  id         String @id @default("default")
  nextNumber Int    @default(1)
}

model JournalEntry {
  id         String        @id @default(cuid())
  number     Int           @unique
  numberLabel String       @unique
  datedAt    DateTime
  memo       String
  sourceType JournalSource
  sourceId   String
  event      String
  cashFlow   CashFlowClass @default(OPERATING)
  reversesId String?       @unique
  postedAt   DateTime      @default(now())
  createdAt  DateTime      @default(now())

  lines     JournalLine[]
  reverses  JournalEntry? @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry? @relation("JournalReversal")

  @@index([datedAt])
  @@index([sourceType, sourceId, event])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Int     @default(0)
  credit    Int     @default(0)
  memo      String?
  productId String?
  quantity  Int?
  sortOrder Int     @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model InventoryLot {
  id              String   @id @default(cuid())
  productId       String
  purchaseOrderId String?
  receivedAt      DateTime
  qtyOriginal     Int
  qtyRemaining    Int
  unitCostPyg     Int
  createdAt       DateTime @default(now())

  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  consumptions  LotConsumption[]

  @@index([productId, receivedAt])
  @@index([purchaseOrderId])
}

model LotConsumption {
  id          String   @id @default(cuid())
  lotId       String
  orderId     String?
  quantity    Int
  unitCostPyg Int
  createdAt   DateTime @default(now())

  lot   InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  order Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@index([orderId])
}

model Expense {
  id             String          @id @default(cuid())
  number         Int?            @unique
  numberLabel    String?         @unique
  kind           ExpenseKind     @default(GENERAL)
  datedAt        DateTime
  description    String
  amountGrossPyg Int
  ivaIncluded    Boolean         @default(true)
  treasury       TreasuryAccount
  accountId      String
  vendor         String?
  reference      String?
  createdAt      DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([datedAt])
  @@index([kind])
}
